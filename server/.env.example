# These are process environment variables; nothing loads a .env file. Set them in the shell or
# in the service definition. Never commit real values.
# Alternatively use a git-ignored config.local.json with the same keys in lowercase
# (storage_root, host, port, ...), named explicitly with YOURNAS_CONFIG. There is no implicit
# lookup in the working directory. Environment variables override the file; an empty variable
# counts as unset.

# Required. Absolute path on a local NTFS drive, not a system directory.
YOURNAS_STORAGE_ROOT=C:\YourNAS-Data

# Bind address. Must be loopback unless YOURNAS_ALLOW_NON_LOOPBACK=true.
YOURNAS_HOST=127.0.0.1
YOURNAS_PORT=8000
YOURNAS_ALLOW_NON_LOOPBACK=false

# DEBUG, INFO, WARNING, ERROR
YOURNAS_LOG_LEVEL=INFO
# Optional. Rotating JSON log file is written here when set.
# YOURNAS_LOG_DIR=C:\YourNAS-Logs

# /docs and /openapi.json are off by default.
YOURNAS_ENABLE_DOCS=false

# SQLite database directory (users, sessions, login throttling). Default: <storage root>\.yournas-data
# YOURNAS_DATA_DIR=C:\YourNAS-App

# Login session limits: sliding idle timeout (hours) and absolute lifetime (days).
YOURNAS_SESSION_IDLE_HOURS=168
YOURNAS_SESSION_LIFETIME_DAYS=30

# Use the last X-Forwarded-For entry as the client address when the TCP peer is loopback.
# Leave false until a trusted proxy (Tailscale Serve) is in front and sets the header.
YOURNAS_TRUST_FORWARDED_FOR=false

# Host header allowlist (DNS-rebinding defence). localhost, 127.0.0.1 and [::1] are always
# accepted; any other Host is refused with 400 invalid_host. List extra names, comma or space
# separated, WITHOUT a port. No wildcards. Add the exact Tailscale MagicDNS name here before
# Tailscale Serve is switched on; the name is not known yet, so leave this unset until it is.
# Only the Host header is used, never X-Forwarded-Host.
# YOURNAS_ALLOWED_HOSTS=

# Strict-Transport-Security on every response. Keep false until HTTPS through Tailscale Serve is
# confirmed working: browsers then refuse plain HTTP to that name for a year.
YOURNAS_ENABLE_HSTS=false

# Optional explicit path to a JSON config file.
# YOURNAS_CONFIG=C:\YourNAS-Config\config.local.json

# Uploads. Sizes are in bytes.
# Largest file one upload may declare (default 20 GiB).
YOURNAS_MAX_UPLOAD_BYTES=21474836480
# At least this much stays free: checked when an upload starts (the unwritten rest of all live
# uploads is reserved) and before every chunk (default 5 GiB).
YOURNAS_FREE_SPACE_FLOOR_BYTES=5368709120
# Largest body of one chunk request, buffered in memory (default 8 MiB, at most 64 MiB).
YOURNAS_UPLOAD_CHUNK_MAX_BYTES=8388608
# Unfinished uploads idle for this many hours are discarded with their staged bytes. Staged
# bytes survive a restart until then.
YOURNAS_UPLOAD_STALE_HOURS=72
# Unfinished uploads one user may have at the same time.
YOURNAS_MAX_UPLOADS_PER_USER=8
# Chunk requests one user may have in flight at once; more get 429 before their body is read.
YOURNAS_MAX_CONCURRENT_CHUNKS_PER_USER=4
# Total declared size of one user's unfinished uploads (default 50 GiB). An upload that would
# take the sum past this is refused with 507 (upload_quota_exceeded).
YOURNAS_MAX_INFLIGHT_UPLOAD_BYTES_PER_USER=53687091200
